{
  "manifest_version": 3,
  "name": "PeopleLens",
  "version": "0.1.0",
  "description": "Generate an article-grounded people cast list from the current page or pasted text.",
  "action": {
    "default_title": "Open PeopleLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://api.deepseek.com/*", "https://api.openai.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
