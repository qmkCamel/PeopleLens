{
  "name": "peoplelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:generate": "node scripts/generate-extension-icons.mjs",
    "build": "tsc -b && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "fixtures:analyze": "node scripts/analyze-fixtures.mjs",
    "openspec": "openspec",
    "openspec:list": "openspec list",
    "openspec:list:specs": "openspec list --specs",
    "openspec:validate": "openspec validate --all",
    "release:check": "node scripts/check-release-assets.mjs",
    "release:package": "npm run validate && node scripts/package-release.mjs",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "validate": "npm run openspec:validate && npm run build && npm run typecheck:extension && npm run build:extension && npm run release:check",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
